{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Veul site and app. The Worker keeps its first name (stockup-preview) so its secrets, KV and D1 bindings stay put;
  // renaming it is part of the full Stockup → Veul rename.
  "name": "stockup-preview",
  // veul.trade (bought 2026-11-25, same Cloudflare account). www redirects to the apex in next.config.ts.
  "routes": [
    { "pattern": "veul.trade", "custom_domain": true },
    { "pattern": "www.veul.trade", "custom_domain": true },
    // The app's own host; next.config.ts maps its paths onto the /app routes.
    { "pattern": "app.veul.trade", "custom_domain": true }
  ],
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "stockup-preview" }],
  // Trending and new-pool lists pushed by the fetcher on the VPS (GMGN bans Cloudflare's shared IPs).
  "kv_namespaces": [{ "binding": "MARKET_FEED", "id": "eb49ed073bae47fa9ff8c47b66912969" }],
  // Ledger of verified real swaps and paybacks (session 1.5). Schema in migrations/.
  "d1_databases": [{ "binding": "LEDGER", "database_name": "stockup-ledger", "database_id": "ac76767b-f09c-4d30-be4f-831b904eb6e8", "migrations_dir": "migrations" }],
  // Still on: the VPS market feed posts to the workers.dev address. Turn off once its FEED_URL is veul.trade.
  // Public settings (not secrets). VeulClaims was deployed by the fee wallet on 2026-11-25 (session 1.6).
  "vars": { "CLAIMS_ADDRESS": "0xee03b98faf05014f699258cd651b2b7eddb54009", "CLAIMS_PREVIOUS": "0xDc19CA2F0110D129CB9cC7CBc990A7f614A5e53A,0x225a42c80e3dad180067e02461de7149ebad951f" },
  // Per-IP limits on the public API (2026-11-26 review): /api/rpc forwards to our paid Alchemy key, and the other
  // routes call the chain and data APIs. The ids only need to be unique within the account.
  "ratelimits": [
    { "name": "RPC_LIMIT", "namespace_id": "4663001", "simple": { "limit": 300, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "4663002", "simple": { "limit": 120, "period": 60 } }
  ],
  "workers_dev": true,
  // No public URL per uploaded version.
  "preview_urls": false,
  "observability": { "enabled": true }
}
